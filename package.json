{
  "name": "dsh-plugin-session-purge",
  "version": "0.2.0",
  "description": "A recycle bin for DeepSeek Harness sessions: deleting a session moves it to a bin at the sidebar foot, where it keeps its title and deletion time and can be restored, deleted permanently, or cleared in bulk. Also adds a session_purge tool for agents.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "purge"
  ],
  "type": "module",
  "license": "MIT",
  "author": "WithPigeon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WithPigeon/dsh-plugin-session-purge.git"
  },
  "homepage": "https://github.com/WithPigeon/dsh-plugin-session-purge#readme",
  "bugs": {
    "url": "https://github.com/WithPigeon/dsh-plugin-session-purge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node verify-session-purge.mjs && node verify-client-half.mjs",
    "test:host": "node verify-session-purge.mjs",
    "test:client": "node verify-client-half.mjs"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src/",
    "locale/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
